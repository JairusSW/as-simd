{
  "name": "as-simd",
  "version": "0.0.0",
  "description": "Drop-in AssemblyScript SIMD-compatible SWAR wrappers with transform support.",
  "main": "./transform/lib/index.js",
  "types": "assembly/index.ts",
  "author": "Jairus Tanaka",
  "contributors": [],
  "license": "MIT",
  "scripts": {
    "test": "ast test --mode simd,swar",
    "prepublishOnly": "npm run build:transform && npm run test:transform && npm test",
    "fuzz": "ast fuzz",
    "fuzz:simd": "ast fuzz --mode simd",
    "fuzz:swar": "ast fuzz --mode swar",
    "fuzz:simd-parity": "ast fuzz --mode simd-parity",
    "test:fuzz": "ast test --fuzz",
    "build:test": "rm -rf ./build/ && asc assembly/test.ts --config none --transform ./transform --enable simd -o ./build/test.wasm",
    "build:transform": "tsc -p ./transform",
    "test:transform": "npm run build:transform && node ./transform/__tests__/api-parity.test.mjs && node ./transform/__tests__/import-paths.test.mjs && node ./transform/__tests__/code-shape.test.mjs && node ./transform/__tests__/wide-kernels.test.mjs && node ./transform/__tests__/wide-lane-exhaustive.test.mjs && node ./transform/__tests__/wide-generic-exhaustive.test.mjs && node ./transform/__tests__/v64-dispatch.test.mjs && node ./transform/__tests__/canonical-simd.test.mjs && node ./transform/__tests__/strict-benches.test.mjs && node ./transform/__tests__/v128-auto.test.mjs",
    "test:wasmtime": "wasmtime ./build/test.wasm",
    "test:wago-wide": "npm run build:transform && node ./scripts/test-wago-wide.mjs",
    "bench": "./scripts/run-bench.sh",
    "bench:wide": "sh ./bench/wide/run.sh",
    "bench:wide-values": "sh ./bench/wide-values/run.sh",
    "bench:wago-v256": "node ./scripts/run-wago-v256-bench.mjs",
    "v8:score": "node ./scripts/v8-score.mjs",
    "format": "prettier -w .",
    "charts": "npm run charts:build && npm run charts:serve",
    "charts:build": "./scripts/build-charts.sh",
    "charts:overview": "bun run ./scripts/overview-v8.chart.ts",
    "charts:register": "bun run ./scripts/register-v8.chart.ts",
    "charts:wide": "bun run ./scripts/wide-v8.chart.ts",
    "charts:wide-values": "bun run ./scripts/wide-values-v8.chart.ts",
    "charts:wago-v256": "bun run ./scripts/wago-v256.chart.ts",
    "charts:serve": "serve ./charts"
  },
  "devDependencies": {
    "@assemblyscript/wasi-shim": "^0.1.0",
    "@types/node": "^25.6.0",
    "as-bench": "^0.0.0-alpha",
    "as-simd": "file:.",
    "as-test": "^1.0.15",
    "assemblyscript": "^0.28.17",
    "assemblyscript-prettier": "^3.0.4",
    "json-as": "^1.3.4",
    "serve": "^14.2.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "assemblyscript": "$assemblyscript"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JairusSW/as-simd.git"
  },
  "keywords": [
    "assemblyscript",
    "SIMD",
    "SSE",
    "AVX"
  ],
  "bugs": {
    "url": "https://github.com/JairusSW/as-simd/issues"
  },
  "homepage": "https://github.com/JairusSW/as-simd#readme",
  "type": "module",
  "files": [
    "assembly/index.ts",
    "assembly/v64/**/*.ts",
    "assembly/v128/**/*.ts",
    "assembly/v256/**/*.ts",
    "assembly/v512/**/*.ts",
    "assembly/v32/**/*.ts",
    "assembly/wide/**/*.ts",
    "assembly/scalar/**/*.ts",
    "transform/lib/",
    "transform/package.json",
    "globals.d.ts",
    "index.ts",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./assembly/index.ts",
      "default": "./transform/lib/index.js"
    },
    "./sources": "./assembly/index.ts",
    "./assembly/index": "./assembly/index.ts",
    "./assembly/v32": "./assembly/v32/index.ts",
    "./assembly/v32/index": "./assembly/v32/index.ts",
    "./assembly/v32/value": "./assembly/v32/value.ts",
    "./assembly/v32/lanes": "./assembly/v32/lanes.ts",
    "./assembly/v32/kernels": "./assembly/v32/kernels.ts",
    "./assembly/v64": "./assembly/v64/index.ts",
    "./assembly/v64/index": "./assembly/v64/index.ts",
    "./assembly/v64/value": "./assembly/v64/value.ts",
    "./assembly/v64/lanes": "./assembly/v64/lanes.ts",
    "./assembly/v64/kernels": "./assembly/v64/kernels.ts",
    "./assembly/v128": "./assembly/v128/index.ts",
    "./assembly/v128/index": "./assembly/v128/index.ts",
    "./assembly/v128/value": "./assembly/v128/value.ts",
    "./assembly/v128/lanes": "./assembly/v128/lanes.ts",
    "./assembly/v128/kernels": "./assembly/v128/kernels.ts",
    "./assembly/v128/v128_swar": "./assembly/v128/v128_swar.ts",
    "./transform": "./transform/lib/index.js",
    "./globals": "./globals.d.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "@JairusSW:registry": "https://npm.pkg.github.com"
  }
}
