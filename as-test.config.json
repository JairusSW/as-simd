{
  "$schema": "./node_modules/as-test/as-test.config.schema.json",
  "input": ["./assembly/__tests__/*.spec.ts"],
  "coverage": true,
  "buildOptions": {
    "target": "wasi",
    "args": ["--enable", "sign-extension"]
  },
  "modes": {
    "swar": {
      "coverage": false,
      "fuzz": {
        "runs": 1000000,
        "input": ["./assembly/__fuzz__/*-swar.fuzz.ts"]
      },
      "buildOptions": {
        "args": ["--enable", "sign-extension", "--transform", "./transform"]
      }
    },
    "simd": {
      "fuzz": {
        "runs": 1000000,
        "input": [
          "./assembly/__fuzz__/*.fuzz.ts",
          "!./assembly/__fuzz__/*-swar.fuzz.ts"
        ]
      },
      "buildOptions": {
        "args": [
          "--enable",
          "sign-extension",
          "--enable simd",
          "--enable relaxed-simd"
        ]
      }
    },
    "simd-parity": {
      "fuzz": {
        "runs": 1000000,
        "input": [
          "./assembly/__fuzz__/i8x8.fuzz.ts",
          "./assembly/__fuzz__/i8x16.fuzz.ts",
          "./assembly/__fuzz__/i8x16-swar.fuzz.ts",
          "./assembly/__fuzz__/i16x4.fuzz.ts",
          "./assembly/__fuzz__/i16x8.fuzz.ts",
          "./assembly/__fuzz__/i16x8-swar.fuzz.ts",
          "./assembly/__fuzz__/i32x2.fuzz.ts",
          "./assembly/__fuzz__/i32x4.fuzz.ts",
          "./assembly/__fuzz__/i32x4-swar.fuzz.ts",
          "./assembly/__fuzz__/i64x2-swar.fuzz.ts",
          "./assembly/__fuzz__/v64.fuzz.ts",
          "./assembly/__fuzz__/widths-swar.fuzz.ts"
        ]
      },
      "buildOptions": {
        "args": [
          "--enable",
          "sign-extension",
          "--enable simd",
          "--enable relaxed-simd"
        ]
      }
    }
  }
}
